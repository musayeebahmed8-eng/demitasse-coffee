.footer-brand p { color: var(--text-muted); margin-top: 0.5rem; }
.footer-links-group { display: flex; flex-direction: column; gap: 0.75rem; }
.footer-links-group h4 { font-size: 1rem; margin-bottom: 0.5rem; }
.footer-links-group a { color: var(--text-muted); text-decoration: none; transition: var(--transition); font-size: 0.9rem; }
.footer-links-group a:hover { color: var(--text-primary); }
.footer-bottom { border-top: 1px solid var(--border-color); padding-top: 2rem; text-align: center; color: var(--text-muted); font-size: 0.85rem; }

