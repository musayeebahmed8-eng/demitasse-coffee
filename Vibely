.drawer-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; }
.drawer-links { display: flex; flex-direction: column; gap: 1.25rem; }
.drawer-links a { color: var(--text-primary); text-decoration: none; font-size: 1.1rem; font-weight: 500; }

