    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
    padding: 2.5rem;
    margin-bottom: 3rem;
    box-shadow: var(--card-shadow);
}
.tool-interface-wrapper h2 { font-size: 2rem; margin-bottom: 0.5rem; }
.tool-interface-wrapper .tool-desc { color: var(--text-muted); margin-bottom: 2rem; }

