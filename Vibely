    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
    max-width: 500px;
    margin: 0 auto;
    padding: 1.5rem;
    text-align: left;
    box-shadow: var(--card-shadow);
    position: relative;
}
.widget-header {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.75rem;
}
.dot { width: 10px; height: 10px; border-radius: 50%; }
.dot.red { background: #ef4444; }
.dot.yellow { background: #f59e0b; }
.dot.green { background: #10b981; }
.widget-title { font-size: 0.8rem; color: var(--text-muted); margin-left: 8px; font-family: monospace; }
.widget-body p { font-size: 1.1rem; font-weight: 500; margin-bottom: 1rem; }
.text-btn { background: none; border: none; color: var(--accent); font-weight: 600; cursor: pointer; font-size: 0.9rem; }

/* Ads & Sections */
.ad-container { margin: 2rem auto; }
.ad-placeholder {
    background: var(--bg-secondary);
    border: 1px dashed var(--border-color);
    color: var(--text-muted);
    text-align: center;
    padding: 1.25rem;
    border-radius: 12px;
    font-size: 0.85rem;
    letter-spacing: 1px;
    text-transform: uppercase;
}
.section { padding: 3rem 0; }
.section-header { margin-bottom: 2rem; }
.section-header h2 { font-size: 2rem; font-weight: 700; letter-spacing: -0.5px; margin-bottom: 0.5rem; }
.section-header p { color: var(--text-muted); }

/* Tool Cards Grid */
.tool-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
}
.tool-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: var(--transition);
    position: relative;
    box-shadow: var(--card-shadow);
}
.tool-card:hover {
    transform: translateY(-4px);
    border-color: rgba(99, 102, 241, 0.4);
}
.tool-icon { font-size: 2.2rem; margin-bottom: 1rem; }
.tool-card h3 { font-size: 1.25rem; margin-bottom: 0.5rem; }
.tool-card p { color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1.5rem; }
.category-tag {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 6px;
    margin-bottom: 1rem;
    width: fit-content;
}
.category-tag.social { background: rgba(236, 72, 153, 0.1); color: #ec4899; }
.category-tag.creator { background: rgba(168, 85, 247, 0.1); color: #a855f7; }
.category-tag.student { background: rgba(59, 130, 246, 0.1); color: #3b82f6; }
.category-tag.fun { background: rgba(16, 185, 129, 0.1); color: #10b981; }
.category-tag.everyday { background: rgba(245, 158, 11, 0.1); color: #f59e0b; }
.card-link { color: var(--text-primary); text-decoration: none; font-weight: 600; font-size: 0.9rem; transition: var(--transition); }
.card-link:hover { color: var(--accent); }

/* Category Cards */
.category-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
}
.cat-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
    padding: 2rem;
    text-decoration: none;
    color: var(--text-primary);
    transition: var(--transition);
}
.cat-card:hover { transform: translateY(-4px); border-color: var(--accent); }
.cat-card h3 { font-size: 1.4rem; margin-bottom: 0.5rem; }
.cat-card p { color: var(--text-muted); font-size: 0.9rem; }

/* Newsletter */
.newsletter-card {
    background: linear-gradient(135deg, var(--bg-card) 0%, var(--bg-secondary) 100%);
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
    padding: 3rem 2rem;
    text-align: center;
}
.newsletter-card h3 { font-size: 1.8rem; margin-bottom: 0.5rem; }
.newsletter-card p { color: var(--text-muted); max-width: 500px; margin: 0 auto 2rem; font-size: 0.95rem; }
#newsletter-form { display: flex; gap: 1rem; justify-content: center; max-width: 450px; margin: 0 auto; }
