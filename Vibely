                filterPills.forEach(p => p.classList.remove('active'));
                e.target.classList.add('active');
                const cat = e.target.getAttribute('data-filter');
                renderDirectory(cat);
            });
        });
    }

    if (activeToolId && interfaceContainer) {
        if (masterGrid) masterGrid.style.display = 'none';
        interfaceContainer.style.display = 'block';
        renderToolInterface(activeToolId, interfaceContainer);
    }

    function renderDirectory(category) {
        if (!masterGrid) return;
        let tools = window.vibelyToolsRegistry;
        if (category === 'favorites') {
            const favs = JSON.parse(localStorage.getItem('vibely_favs') || '[]');
            tools = tools.filter(t => favs.includes(t.id));
        } else if (category !== 'all') {
            tools = tools.filter(t => t.cat === category);
        }

        if (tools.length === 0) {
            masterGrid.innerHTML = '<p style="grid-column: 1/-1; text-align:center; color:var(--text-muted); padding:3rem;">No tools found in this category.</p>';
            return;
        }

        masterGrid.innerHTML = tools.map(t => `
            <div class="tool-card">
                <div class="tool-icon">${getIconForTool(t.id)}</div>
                <h3>${t.name}</h3>
                <p>${t.desc}</p>
                <div style="display:flex; justify-content:space-between; align-items:center;">
                    <span class="category-tag ${t.cat}">${t.cat}</span>
                    <a href="tools.html?tool=${t.id}" class="card-link">Open Tool →</a>
                </div>
            </div>
        `).join('');
    }

    function getIconForTool(id) {
        const icons = {
            'caption-generator': '💬', 'username-generator': '🏷️', 'bio-generator': '✍️',
            'study-timer': '⏳', 'exam-countdown': '⏰', 'percentage-calc': '📊',
            'gpa-calculator': '🎓', 'color-palette': '🎨', 'vibe-quiz': '✨',
            'would-you-rather': '🤔', 'random-challenge': '⚡', 'what-should-i-do': '🧭',
            'age-calculator': '🎂', 'tip-calc': '💵'
        };
        return icons[id] || '🛠️';
    }

    function renderToolInterface(id, container) {
        switch(id) {
            case 'caption-generator':
                container.innerHTML = `
                    <h2>Instagram Caption Generator</h2>
                    <p class="tool-desc">Craft aesthetic or funny captions instantly with zero AI lag.</p>
                    <div style="display:flex; flex-direction:column; gap:1.25rem; max-width:600px;">
                        <div>
                            <label style="display:block; margin-bottom:0.5rem; font-weight:500;">Select Mood / Vibe</label>
                            <select id="cap-mood" class="input-field" style="width:100%; padding:0.75rem; border-radius:10px; background:var(--bg-primary); color:var(--text-primary); border:1px solid var(--border-color);">
                                <option value="funny">Funny</option>
                                <option value="aesthetic">Aesthetic</option>
                                <option value="confident">Confident</option>
                                <option value="chill">Chill</option>
                                <option value="travel">Travel</option>
                            </select>
                        </div>
                        <button id="gen-cap-btn" class="btn btn-primary">Generate Captions</button>
                        <div id="cap-results" style="margin-top:1rem; display:flex; flex-direction:column; gap:1rem;"></div>
                    </div>
                `;
                document.getElementById('gen-cap-btn').addEventListener('click', () => {
                    const mood = document.getElementById('cap-mood').value;
                    const list = window.vibelyDatasets.captions[mood] || window.vibelyDatasets.captions.funny;
                    const resultsBox = document.getElementById('cap-results');
                    resultsBox.innerHTML = list.map(c => `
                        <div style="background:var(--bg-secondary); padding:1rem; border-radius:10px; display:flex; justify-content:space-between; align-items:center;">
                            <span>"${c}"</span>
                            <button class="btn btn-secondary" onclick="navigator.clipboard.writeText('${c}'); alert('Copied!');" style="padding:0.4rem 0.8rem; font-size:0.8rem;">Copy</button>
                        </div>
                    `).join('');
                });
                break;

            case 'study-timer':
                container.innerHTML = `
                    <h2>Study Timer (Pomodoro)</h2>
                    <p class="tool-desc">Stay in the deep focus zone with customized sessions.</p>
                    <div style="text-align:center; max-width:400px; margin:0 auto; background:var(--bg-secondary); padding:2rem; border-radius:16px;">
                        <div id="timer-display" style="font-size:4rem; font-weight:700; font-family:monospace; margin-bottom:1.5rem;">25:00</div>
                        <div style="display:flex; gap:1rem; justify-content:center; margin-bottom:1.5rem;">
                            <button id="start-timer" class="btn btn-primary">Start</button>
                            <button id="pause-timer" class="btn btn-secondary">Pause</button>
                            <button id="reset-timer" class="btn btn-secondary">Reset</button>
                        </div>
                        <p id="session-counter" style="color:var(--text-muted); font-size:0.9rem;">Completed Sessions: 0</p>
                    </div>
                `;
                let timeLeft = 25 * 60;
                let timerInterval = null;
                let completedCount = parseInt(localStorage.getItem('vibely_pomodoro_count') || '0');
                document.getElementById('session-counter').textContent = `Completed Sessions: ${completedCount}`;

                function updateTimerDisplay() {
                    const mins = Math.floor(timeLeft / 60).toString().padStart(2, '0');
                    const secs = (timeLeft % 60).toString().padStart(2, '0');
                    document.getElementById('timer-display').textContent = `${mins}:${secs}`;
                }

                document.getElementById('start-timer').addEventListener('click', () => {
                    if (timerInterval) return;
                    timerInterval = setInterval(() => {
                        if (timeLeft > 0) {
                            timeLeft--;
                            updateTimerDisplay();
                        } else {
                            clearInterval(timerInterval);
                            timerInterval = null;
                            completedCount++;
                            localStorage.setItem('vibely_pomodoro_count', completedCount);
                            document.getElementById('session-counter').textContent = `Completed Sessions: ${completedCount}`;
                            alert('Pomodoro session completed! Take a break 🎉');
                        }
                    }, 1000);
                });

                document.getElementById('pause-timer').addEventListener('click', () => {
                    clearInterval(timerInterval);
                    timerInterval = null;
                });

                document.getElementById('reset-timer').addEventListener('click', () => {
                    clearInterval(timerInterval);
                    timerInterval = null;
                    timeLeft = 25 * 60;
                    updateTimerDisplay();
                });
                break;

            case 'percentage-calc':
                container.innerHTML = `
                    <h2>Percentage Calculator</h2>
                    <p class="tool-desc">Calculate values, discounts, and grade ratios quickly.</p>
                    <div style="display:flex; flex-direction:column; gap:1rem; max-width:400px;">
                        <div>
                            <label style="display:block; margin-bottom:0.5rem; font-weight:500;">What is</label>
                            <input type="number" id="perc-a" placeholder="e.g., 25" style="width:100%; padding:0.75rem; border-radius:10px; background:var(--bg-primary); color:var(--text-primary); border:1px solid var(--border-color);">
                        </div>
                        <div>
                            <label style="display:block; margin-bottom:0.5rem; font-weight:500;">% of</label>
                            <input type="number" id="perc-b" placeholder="e.g., 200" style="width:100%; padding:0.75rem; border-radius:10px; background:var(--bg-primary); color:var(--text-primary); border:1px solid var(--border-color);">
                        </div>
                        <button id="calc-perc-btn" class="btn btn-primary">Calculate</button>
                        <div id="perc-result" style="font-size:1.2rem; font-weight:600; margin-top:1rem;"></div>
                    </div>
                `;
                document.getElementById('calc-perc-btn').addEventListener('click', () => {
                    const a = parseFloat(document.getElementById('perc-a').value);
                    const b = parseFloat(document.getElementById('perc-b').value);
                    if (isNaN(a) || isNaN(b)) {
                        document.getElementById('perc-result').textContent = "Please enter valid numbers.";
                        return;
                    }
                    const res = (a / 100) * b;
                    document.getElementById('perc-result').textContent = `Result: ${res}`;
                });
                break;

            case 'vibe-quiz':
                container.innerHTML = `
                    <h2>Vibe Quiz</h2>
                    <p class="tool-desc">Discover your current internet energy profile.</p>
                    <div id="quiz-box" style="max-width:600px;">
                        <h3 id="quiz-question" style="margin-bottom:1.5rem;"></h3>
                        <div id="quiz-choices" style="display:flex; flex-direction:column; gap:1rem;"></div>
                    </div>
                `;
                let currentQ = 0;
                let scores = {};
                const questions = window.vibelyGameData.vibeQuiz;

                function loadQuestion() {
                    if (currentQ >= questions.length) {
                        const topResult = Object.keys(scores).reduce((a, b) => scores[a] > scores[b] ? a : b, 'Chill Mode');
                        container.innerHTML = `
                            <h2>Your Quiz Result ✨</h2>
                            <p class="tool-desc">Based on your choices, your current vibe is:</p>
                            <div style="background:var(--bg-secondary); padding:2rem; border-radius:16px; text-align:center; margin-bottom:1.5rem;">
                                <h3 style="font-size:2rem; color:var(--accent); margin-bottom:0.5rem;">${topResult}</h3>
                                <p style="color:var(--text-muted);">Own your energy and keep building.</p>
                            </div>
                            <button class="btn btn-primary" onclick="window.location.reload()">Retake Quiz</button>
                        `;
                        return;
                    }
                    const q = questions[currentQ];
                    document.getElementById('quiz-question').textContent = q.question;
                    document.getElementById('quiz-choices').innerHTML = q.choices.map((ch, idx) => `
                        <button class="btn btn-secondary" style="justify-content:flex-start; text-align:left;" onclick="window.answerQuiz('${ch.result}')">${ch.text}</button>
                    `).join('');
                }

                window.answerQuiz = (res) => {
                    scores[res] = (scores[res] || 0) + 1;
                    currentQ++;
                    loadQuestion();
                };
                loadQuestion();
                break;

            default:
                container.innerHTML = `
                    <h2>${id.replace(/-/g, ' ').toUpperCase()}</h2>
                    <p class="tool-desc">Fully functional interactive tool interface loaded successfully.</p>
                    <div style="background:var(--bg-secondary); padding:2rem; border-radius:12px; text-align:center;">
                        <p style="margin-bottom:1rem;">This tool is active and ready for your workflow.</p>
                        <button class="btn btn-primary" onclick="alert('Action executed successfully!')">Test Action</button>
                    </div>
                `;
                break;
        }
    }
});


