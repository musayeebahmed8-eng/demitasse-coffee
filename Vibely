.static-page { padding: 4rem 0; max-width: 800px; }
.static-page h1 { font-size: 2.5rem; margin-bottom: 1.5rem; }
.static-page h2 { font-size: 1.5rem; margin-top: 2rem; margin-bottom: 1rem; }
.static-page p, .static-page li { color: var(--text-muted); margin-bottom: 1rem; }
.static-page ul { padding-left: 1.5rem; }

/* 404 Error */
.error-container { text-align: center; padding: 15vh 1.5rem; }
.error-container h1 { font-size: clamp(2rem, 5vw, 3.5rem); margin-bottom: 1rem; }
.error-container p { color: var(--text-muted); margin-bottom: 2rem; }
.error-actions { display: flex; gap: 1rem; justify-content: center; }

